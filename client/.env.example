## Transport selection is config-driven only:
## 1. Supabase when both values below are set (current production-default path)
## 2. Websocket only when VITE_BACKEND_URL is explicitly set (optional local realtime runtime)
## 3. Demo by default when neither backend is configured
# VITE_BACKEND_URL=http://localhost:8080
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-anon-key>

## Optional public/LAN base URL for teacher QR codes and join links.
## Use this when the teacher opens the app on localhost but students join from phones/tablets.
# VITE_PUBLIC_APP_URL=http://192.168.1.20:5173

## Optional explicit classroom local development adapter.
## Production classroom rooms should use Supabase. In Vite dev, local-dev is enabled
## automatically when Supabase is missing; set this for explicit non-standard dev runs.
# VITE_CLASSROOM_LOCAL_DEV=true
